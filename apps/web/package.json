{
  "name": "@moto-trails/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:live": "STORAGE_TEST_LIVE=1 node --env-file-if-exists=.env.local ../../node_modules/vitest/vitest.mjs run live",
    "storage:setup": "tsx --env-file-if-exists=.env.local scripts/storage-setup.mts",
    "storage:smoke": "tsx --env-file-if-exists=.env.local scripts/storage-smoke.mts",
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:reset": "bash scripts/dev-db.sh reset",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:seed:regions": "tsx --env-file-if-exists=.env.local scripts/db-seed-regions.mts",
    "db:import": "tsx --env-file-if-exists=.env.local scripts/import-trails.mts",
    "db:seed:places": "tsx --env-file-if-exists=.env.local scripts/db-seed-places.mts",
    "assets:maplibre": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run assets:maplibre",
    "prebuild": "npm run assets:maplibre"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@moto-trails/domain": "*",
    "@moto-trails/tokens": "*",
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "^5.11.2",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
