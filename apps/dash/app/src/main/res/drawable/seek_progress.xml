<?xml version="1.0" encoding="utf-8"?>
<!-- Progress bar: a translucent track (scrim.track) with an ink fill, fully rounded. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/seek_track" />
            <corners android:radius="@dimen/radius_chip" />
            <size android:height="@dimen/space_1" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/seek_fill" />
                <corners android:radius="@dimen/radius_chip" />
                <size android:height="@dimen/space_1" />
            </shape>
        </clip>
    </item>
</layer-list>
