<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Myto Dash theme. DayNight, so values-night/colors.xml swaps the palette.
      Every TextView gets Geist through textViewStyle; a view that needs a
      different voice sets a TextAppearance.Myto.* style.
    -->
    <style name="Theme.Myto" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorPrimary">@color/ink_fill</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/edge</item>
        <item name="colorControlActivated">@color/ink_fill</item>
        <item name="colorControlHighlight">@color/divider</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textViewStyle">@style/Widget.Myto.TextView</item>
        <item name="android:editTextStyle">@style/Widget.Myto.EditText</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
        <item name="alertDialogTheme">@style/Theme.Myto.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Myto.Dialog</item>
    </style>

    <!-- Dialogs: a card-coloured sheet with the sheet corner, Geist text, ink buttons. -->
    <style name="Theme.Myto.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <!-- Myto uses no shadows: the sheet stands out by colour and the dimmed page. -->
        <item name="android:windowElevation">0dp</item>
        <item name="colorAccent">@color/text_primary</item>
        <item name="colorControlActivated">@color/ink_fill</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Myto.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Myto.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Myto.DialogButton</item>
    </style>

    <style name="Widget.Myto.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="fontFamily">@font/geist_medium</item>
        <item name="android:textSize">@dimen/type_label</item>
    </style>

    <style name="Widget.Myto.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Myto.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
</resources>
