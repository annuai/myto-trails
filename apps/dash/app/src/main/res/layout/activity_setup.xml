<?xml version="1.0" encoding="utf-8"?>
<!-- First run: pick the apps behind the tabs and grant the two optional permissions. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textAppearance="@style/TextAppearance.Myto.Hero"
            android:fontFamily="@font/michroma"
            android:textSize="@dimen/type_hero"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginBottom="@dimen/space_6"
            android:text="@string/setup_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_body" />

        <LinearLayout android:id="@+id/choosePhoneRow" style="@style/SetupRow">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_choose_phone"
                android:fontFamily="@font/geist_medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_body" />
            <TextView
                android:id="@+id/phoneValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:text="@string/not_set"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_label" />
        </LinearLayout>

        <LinearLayout android:id="@+id/chooseNavRow" style="@style/SetupRow">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_choose_nav"
                android:fontFamily="@font/geist_medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_body" />
            <TextView
                android:id="@+id/navValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:text="@string/not_set"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_label" />
        </LinearLayout>

        <LinearLayout android:id="@+id/chooseMediaRow" style="@style/SetupRow">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_choose_media"
                android:fontFamily="@font/geist_medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_body" />
            <TextView
                android:id="@+id/mediaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:text="@string/not_set"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_label" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/setup_permissions"
            android:fontFamily="@font/geist_semibold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_section" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginBottom="@dimen/space_3"
            android:text="@string/setup_permissions_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_label" />

        <LinearLayout android:id="@+id/locationRow" style="@style/SetupRow">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_location_access"
                android:fontFamily="@font/geist_medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_body" />
            <TextView
                android:id="@+id/locationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:text="@string/access_needed"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_label" />
        </LinearLayout>

        <LinearLayout android:id="@+id/mediaAccessRow" style="@style/SetupRow">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_notification_access"
                android:fontFamily="@font/geist_medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_body" />
            <TextView
                android:id="@+id/mediaAccessValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_half"
                android:text="@string/access_needed"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_label" />
        </LinearLayout>

        <TextView
            android:id="@+id/doneButton"
            style="@style/Widget.Myto.Button"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/setup_done" />
    </LinearLayout>
</ScrollView>
