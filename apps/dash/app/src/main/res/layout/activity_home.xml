<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== Top status bar: home | favorites dock | wifi ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_height"
        android:background="@drawable/bar_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:layout_marginStart="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_3"
        android:layout_marginTop="@dimen/space_3">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/homeButton"
            android:layout_width="@dimen/size_compact"
            android:layout_height="@dimen/size_compact"
            android:padding="@dimen/space_3"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tab_apps"
            app:srcCompat="@drawable/ic_home" />

        <!-- Favorite-apps dock (quick launch). Slots are bound in code. -->
        <LinearLayout
            android:id="@+id/favoritesDock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/wifiIcon"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:contentDescription="@string/tab_settings"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_wifi" />

        <!-- Settings lives here rather than in the tab bar (whose tab is off by default). -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/settingsButton"
            android:layout_width="@dimen/size_compact"
            android:layout_height="@dimen/size_compact"
            android:layout_marginStart="@dimen/space_2"
            android:padding="@dimen/space_3"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tab_settings"
            app:srcCompat="@drawable/ic_settings" />
    </LinearLayout>

    <!-- ===== Middle: map (left) + panel (right) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="@dimen/space_2">

        <!-- Clock + weather dashboard -->
        <LinearLayout
            android:id="@+id/clockPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:layout_marginEnd="@dimen/space_2"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/panel_padding"
            android:background="@drawable/card_dark">


            <LinearLayout
                android:id="@+id/clockSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                    <!-- Analog face — shown instead of bigClock when that style is picked -->
                <com.myto.dash.AnalogClockView
                    android:id="@+id/analogClock"
                    android:layout_width="@dimen/analog_clock"
                    android:layout_height="@dimen/analog_clock"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/bigClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/clock_text"
                    android:fontFamily="@font/michroma"
        android:letterSpacing="-0.01"
        android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/bigDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/date_margin_bottom"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/date_text" />
                <!-- Stopwatch — hidden unless enabled in Settings -->
                <LinearLayout
                    android:id="@+id/chronoRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/chronoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_3"
                        android:minWidth="@dimen/chrono_width"
                        android:text="0:00.00"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/chrono_text"
                        android:fontFamily="@font/geist_mono_medium" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/chronoToggle"
                        android:layout_width="@dimen/chrono_button"
                        android:layout_height="@dimen/chrono_button"
                        android:padding="@dimen/space_3"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/chrono_start_stop"
                        app:srcCompat="@drawable/ic_play" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/chronoReset"
                        android:layout_width="@dimen/chrono_button"
                        android:layout_height="@dimen/chrono_button"
                        android:padding="@dimen/space_3"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/chrono_reset"
                        app:srcCompat="@drawable/ic_reset" />
                </LinearLayout>
            </LinearLayout>

            <!-- Or, in portrait: hosted app widgets in its place -->
            <LinearLayout
                android:id="@+id/clockWidget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone" />



            <!-- Weather row: icon + temperature + description -->
            <LinearLayout
                android:id="@+id/weatherSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                    <LinearLayout
                    android:id="@+id/weatherRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="@dimen/weather_icon"
                        android:layout_height="@dimen/weather_icon"
                        android:layout_marginEnd="@dimen/space_4"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_wx_cloudy" />

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_3"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/weather_temp"
                        android:fontFamily="@font/geist_mono_medium" />

                    <TextView
                        android:id="@+id/weatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_loading"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/weather_desc" />
                </LinearLayout>

                <!-- Upcoming-days forecast strip -->
                <LinearLayout
                    android:id="@+id/forecastRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forecast_margin_top"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <LinearLayout style="@style/FcCell">
                        <TextView android:id="@+id/fc0Day" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/type_caption" />
                        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc0Icon"
                            android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                            android:layout_marginTop="@dimen/space_half" android:layout_marginBottom="@dimen/space_half"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                        <TextView android:id="@+id/fc0Temp" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="@dimen/type_caption"
        android:fontFamily="@font/geist_mono_regular" />
                    </LinearLayout>

                    <LinearLayout style="@style/FcCell">
                        <TextView android:id="@+id/fc1Day" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/type_caption" />
                        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc1Icon"
                            android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                            android:layout_marginTop="@dimen/space_half" android:layout_marginBottom="@dimen/space_half"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                        <TextView android:id="@+id/fc1Temp" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="@dimen/type_caption"
        android:fontFamily="@font/geist_mono_regular" />
                    </LinearLayout>

                    <LinearLayout style="@style/FcCell">
                        <TextView android:id="@+id/fc2Day" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/type_caption" />
                        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc2Icon"
                            android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                            android:layout_marginTop="@dimen/space_half" android:layout_marginBottom="@dimen/space_half"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                        <TextView android:id="@+id/fc2Temp" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="@dimen/type_caption"
        android:fontFamily="@font/geist_mono_regular" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Or, in portrait: hosted app widgets in its place -->
            <LinearLayout
                android:id="@+id/weatherWidget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone" />


            <!-- Phone-projection shortcuts -->
            <LinearLayout
                android:id="@+id/projectionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/shortcut_margin_top"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/shortcutAndroidAuto"
                    style="@style/ProjectionTile">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_2"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_android_auto" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/shortcut_android_auto"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/type_caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shortcutCarPlay"
                    style="@style/ProjectionTile">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_2"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_carplay" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/shortcut_carplay"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/type_caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right column: media widget + phone card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Media player widget (real now-playing when available) -->
            <LinearLayout
                android:id="@+id/mediaCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="@dimen/space_2"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="@dimen/space_4"
                android:background="@drawable/card_blue"
                android:foreground="?android:attr/selectableItemBackground">
                <!-- Default: the media player itself -->
                <LinearLayout
                    android:id="@+id/mediaDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Album art: rounded bitmap set in code, on a rounded tile -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/mediaArt"
                            android:tag="noTint"
                            android:layout_width="@dimen/album_art"
                            android:layout_height="@dimen/album_art"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@drawable/art_bg"
                            android:padding="@dimen/album_art_padding"
                            android:scaleType="centerCrop"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_audio" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/mediaTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="marquee"
                                android:singleLine="true"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:text="@string/now_playing"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/media_title"
                                android:fontFamily="@font/geist_semibold" />

                            <TextView
                                android:id="@+id/mediaArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_half"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text=""
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/type_label" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Seek row: elapsed | bar | total (hidden when no duration) -->
                    <LinearLayout
                        android:id="@+id/mediaSeekRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/mediaElapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="34dp"
                            android:text="0:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/type_caption"
        android:fontFamily="@font/geist_mono_regular" />

                        <SeekBar
                            android:id="@+id/mediaProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:progressDrawable="@drawable/seek_progress"
                            android:thumb="@drawable/seek_thumb"
                            android:thumbOffset="0dp" />

                        <TextView
                            android:id="@+id/mediaTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="34dp"
                            android:gravity="end"
                            android:text="0:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/type_caption"
        android:fontFamily="@font/geist_mono_regular" />
                    </LinearLayout>

                    <!-- Transport controls (hidden when nothing is playing) -->
                    <LinearLayout
                        android:id="@+id/mediaControls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btnPrev"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="@dimen/space_2"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/media_previous"
                            app:srcCompat="@drawable/ic_skip_previous" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btnPlayPause"
                            android:tag="noTint"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="@dimen/space_5"
                            android:layout_marginEnd="@dimen/space_5"
                            android:padding="@dimen/space_3"
                            android:background="@drawable/btn_circle"
                            android:contentDescription="@string/media_play_pause"
                            app:srcCompat="@drawable/ic_play" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btnNext"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="@dimen/space_2"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/media_next"
                            app:srcCompat="@drawable/ic_skip_next" />
                    </LinearLayout>

                    <!-- Media volume — hidden when the card is too short for it -->
                    <LinearLayout
                        android:id="@+id/mediaVolumeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/volumeIcon"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="@dimen/space_2"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/volume_mute"
                            app:srcCompat="@drawable/ic_volume" />

                        <SeekBar
                            android:id="@+id/volumeSlider"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_1"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:progressDrawable="@drawable/seek_progress"
                            android:thumb="@drawable/seek_thumb"
                            android:thumbOffset="0dp" />
                    </LinearLayout>
            
                </LinearLayout>

                <!-- Or: user-chosen app shortcuts, populated in code -->
                <LinearLayout
                    android:id="@+id/mediaShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Or: hosted Android app widgets, side by side -->
                <LinearLayout
                    android:id="@+id/mediaWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Phone -->
            <!-- Hugs its content so the media card above takes the leftover height,
                 instead of both stretching and leaving large gaps. -->
            <LinearLayout
                android:id="@+id/phoneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/phone_card_height"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="@dimen/space_4"
                android:background="@drawable/card_sand"
                android:foreground="?android:attr/selectableItemBackground">

                <!-- Default: a plain Phone shortcut -->
                <LinearLayout
                    android:id="@+id/phoneDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@string/tab_phone"
                        app:srcCompat="@drawable/ic_phone" />

                    <TextView
                        android:id="@+id/phoneLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_phone"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/type_body"
        android:fontFamily="@font/geist_medium" />
                </LinearLayout>

                <!-- Or: user-chosen app shortcuts, populated in code -->
                <LinearLayout
                    android:id="@+id/panelShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Or: a hosted Android app widget -->
                <LinearLayout
                    android:id="@+id/panelWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Portrait app drawer: fills the space left under the cards.
                 Present in landscape too (kept gone) only so ViewBinding sees the
                 same ids in both variants. -->
            <LinearLayout
                android:id="@+id/portraitDrawer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/space_2"
                android:minHeight="140dp"
                android:orientation="vertical"
                android:padding="@dimen/space_3"
                android:background="@drawable/card_dark"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/portraitDrawerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_apps" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/all_apps"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/type_body" />
                </LinearLayout>

                <!-- One page of app tiles, built in code; swipe to change page -->
                <com.myto.dash.SwipeLinearLayout
                    android:id="@+id/portraitDrawerGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/space_1"
                    android:orientation="vertical" />

                <!-- Page dots; swipe the grid or tap a dot to change page -->
                <LinearLayout
                    android:id="@+id/portraitDrawerDots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Bottom tab bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/tabBar"
        android:layout_height="@dimen/tab_bar_height"
        android:orientation="horizontal"
        android:background="@drawable/bar_bg"
        android:baselineAligned="false"
        android:layout_marginStart="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_3"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2">
    </LinearLayout>
</LinearLayout>
