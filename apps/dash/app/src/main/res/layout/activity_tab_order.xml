<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SettingsSection" android:text="@string/section_tabs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginBottom="@dimen/space_3"
                android:text="@string/tabs_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_label" />

            <LinearLayout
                android:id="@+id/tabList"
                style="@style/SettingsGroup" />

            <TextView
                android:id="@+id/resetTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:layout_marginStart="@dimen/space_1"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_3"
                android:text="@string/tabs_reset"
                android:textColor="@color/accent"
                android:textSize="@dimen/type_label"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
