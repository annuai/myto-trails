{
  "expo": {
    "name": "Myto",
    "slug": "myto",
    "scheme": "myto",
    "icon": "./assets/icon.png",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.myto-moto.myto"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#b0442e",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Myto uses your photos for your profile picture, your bike, club covers and the photos of your documents.",
          "cameraPermission": "Myto uses the camera to photograph your licence, registration, insurance and PUC. The photos stay on this phone."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Myto records your ride's route while you ride."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Myto asks for Face ID before it shows a photo of your documents."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/myto-logo.png"
    },
    "android": {
      "package": "com.myto.app"
    }
  }
}
