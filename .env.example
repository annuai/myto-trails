# Copy to apps/web/.env.local and fill in. Never commit real values.

# Site: https://moto-trails.com in production; leave blank in development (http://localhost:3000).
SITE_URL=

# Object storage: memory | r2 | supabase.
# memory is the default in development and is not allowed in production.
STORAGE_PROVIDER=memory

# Cloudflare R2 (used when STORAGE_PROVIDER=r2). One bucket; logical buckets are key prefixes.
# R2_PUBLIC_BASE_URL is the public base URL for the public/ prefix, e.g. https://media.example.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Supabase (database/auth now; storage when STORAGE_PROVIDER=supabase).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the public (publishable) key.
# SUPABASE_SERVICE_ROLE_KEY is SECRET: server only, bypasses all access rules.
# DATABASE_URL is the Postgres connection string, server only. Required in production.
# Local development: postgres://localhost:54329/moto_trails (start it with npm run db:start -w @moto-trails/web).
# Tests use TEST_ADMIN_URL (default postgres://localhost:54329/postgres) to create throwaway databases.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PREFIX=trails
DATABASE_URL=

# Map (MapLibre). The default is the free MapLibre demo style, for development only.
# Set a real style URL and the attribution text its licence requires (for example "© OpenStreetMap contributors").
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Email for sign-in links: console (development; prints the link in the server log) or resend (production).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
