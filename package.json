{
  "name": "moto-trails",
  "private": true,
  "version": "0.11.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling"
  ],
  "scripts": {
    "postinstall": "if command -v patch-package >/dev/null 2>&1; then patch-package; else echo 'patch-package not installed here (web-only install), skipping mobile patches'; fi",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:colors": "node tooling/check-colors.mjs",
    "check:tokens": "node tooling/check-tokens.mjs",
    "check:versions": "node tooling/check-versions.mjs",
    "deck:build": "node docs/myto-strategy/presentation/build.mjs",
    "deck:pdf": "node docs/myto-strategy/presentation/export-pdf.js",
    "deck:pptx": "node docs/myto-strategy/presentation/build-pptx.mjs",
    "pitch:build": "DECK=pitch node docs/myto-strategy/presentation/build.mjs",
    "pitch:pdf": "DECK=pitch node docs/myto-strategy/presentation/export-pdf.js",
    "pitch:pptx": "DECK=pitch node docs/myto-strategy/presentation/build-pptx.mjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "pptxgenjs": "^4.0.1"
  }
}
