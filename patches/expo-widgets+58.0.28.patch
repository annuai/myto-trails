+  val modifiers = propsMap()?.takeIf { it.hasKey("modifiers") && !it.isNull("modifiers") }?.getArray("modifiers")
+  val weighted = (0 until (modifiers?.size() ?: 0)).any { modifiers?.getMap(it)?.getString("\$type") == "weight" }
+  if (weighted) {
+    nodes.forEach {
+      it.modifier = it.modifier.then(if (horizontal) WidthModifier(Dimension.Expand) else HeightModifier(Dimension.Expand))
+    }
   }
